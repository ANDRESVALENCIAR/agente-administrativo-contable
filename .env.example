# ── CONTROL DE PAGOS · alertas 24h con botón "Ya lo pagué" ──
# Ruta del libro (hojas "Maestro de Pagos", "Calendario Anual", "Festivos")
PAGOS_CONTROL_EXCEL=./data/Control_de_pagos_Shaki.xlsx
# 1 = al confirmar un pago se escribe Estado/Fecha pago real en el Excel (con respaldo .bak)
PAGOS_ESCRIBIR_EXCEL=1
# Quién recibe la alerta (coma). Vacío = EMAIL_PAGOS / WHATSAPP_DESTINATARIOS
PAGOS_ALERTA_EMAILS=
PAGOS_ALERTA_WHATSAPP=
# Dirección pública del dashboard: el botón del correo/WhatsApp abre esta URL
APP_PUBLIC_URL=http://localhost:8501
# Frase secreta para firmar los enlaces (cámbiela en producción)
PAGOS_LINK_SECRET=

# ── ENVÍO REAL DE ALERTAS (no depende de ANTHROPIC_API_KEY) ──
# Correo por SMTP. Gmail: smtp.gmail.com / 587 / su correo / contraseña de aplicación de 16 letras
# Office 365: smtp.office365.com / 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# WhatsApp en producción: plantilla aprobada en Twilio (Content SID HX...) con variables
# {{1}} detalle · {{2}} fecha · {{3}} valor · {{4}} enlace "Ya lo pagué"
TWILIO_WHATSAPP_CONTENT_SID=
# Túnel público estable para el botón (opcional, ver scripts/iniciar_shaki_24x7.ps1)
NGROK_DOMAIN=

